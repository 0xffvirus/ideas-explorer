# Copy to .env.local and adjust. All NEXT_PUBLIC_* values are inlined at build time.

# Base URL of the Idea Forge API (FastAPI). Used by lib/api/client.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000

# "enabled" serves the app from in-browser MSW mocks (dev/e2e). Keep "disabled"
# when a real backend is running.
NEXT_PUBLIC_API_MOCKING=disabled
