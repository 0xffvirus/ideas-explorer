{
  "openapi": "3.1.0",
  "info": {
    "title": "Idea Forge API",
    "version": "0.1.0",
    "description": "Contract snapshot authored from SPEC-idea-core.md, SPEC-agent-pipeline.md, SPEC-reports.md and SPEC-web-app.md. Regenerate the TS client with `pnpm gen:api` (point OPENAPI_URL at a live backend to diff). snake_case JSON. Endpoints marked x-assumed are not defined by a module spec yet and need backend sign-off (see docs/API-CONTRACT-NOTES.md)."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "http://localhost:8000"
        }
      }
    }
  ],
  "paths": {
    "/ideas": {
      "post": {
        "operationId": "createIdea",
        "summary": "Create an idea and optionally enqueue analysis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIdeaRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaDetail"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "get": {
        "operationId": "listIdeas",
        "summary": "List or search ideas (hybrid by default)",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/SearchMode"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/IdeaStatus"
            }
          },
          {
            "name": "verdict",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Verdict"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Sort"
            }
          },
          {
            "name": "min_score",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "max_score",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "archived",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "pinned",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaList"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/ideas/{id}": {
      "get": {
        "operationId": "getIdea",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdeaId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "operationId": "updateIdea",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdeaId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateIdeaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/ideas/{id}/versions": {
      "post": {
        "operationId": "createIdeaVersion",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdeaId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVersionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/ideas/{id}/similar": {
      "get": {
        "operationId": "getSimilarIdeas",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdeaId"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaList"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/ideas/{id}/report": {
      "get": {
        "operationId": "getIdeaReport",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdeaId"
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/ideas/{id}/report.md": {
      "get": {
        "operationId": "getIdeaReportMarkdown",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdeaId"
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown report",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/ideas/{id}/report.pdf": {
      "get": {
        "operationId": "getIdeaReportPdf",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdeaId"
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF report",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/tags": {
      "get": {
        "operationId": "listTags",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/compare": {
      "get": {
        "operationId": "compareIdeas",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated list of 2-3 idea ids"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/runs/{id}/steps/{step}/rerun": {
      "post": {
        "operationId": "rerunRunStep",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "step",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RunStepName"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/runs/{id}/respond": {
      "post": {
        "operationId": "respondToRun",
        "x-assumed": true,
        "summary": "Answer or skip clarifying questions (assumed; see docs/API-CONTRACT-NOTES.md)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespondRunRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/runs/{id}/events": {
      "get": {
        "operationId": "streamRunEvents",
        "summary": "Server-Sent Events for a run; resumable with Last-Event-ID or ?last_event_id=",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "last_event_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream of RunEvent",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/RunEvent"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IdeaId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["detail"],
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": ["detail"],
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["loc", "msg"],
              "properties": {
                "loc": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "msg": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "IdeaStatus": {
        "type": "string",
        "enum": ["draft", "queued", "analyzing", "done", "failed"]
      },
      "Verdict": {
        "type": "string",
        "enum": ["pursue", "refine", "park"]
      },
      "SearchMode": {
        "type": "string",
        "enum": ["hybrid", "keyword", "semantic"]
      },
      "Sort": {
        "type": "string",
        "enum": ["recent", "score", "title"]
      },
      "RunStatus": {
        "type": "string",
        "enum": ["queued", "running", "awaiting_input", "done", "failed", "partial"]
      },
      "RunStepName": {
        "type": "string",
        "enum": [
          "refine",
          "clarify",
          "market",
          "competitors",
          "customers",
          "feasibility",
          "business_model",
          "critic"
        ]
      },
      "StepStatus": {
        "type": "string",
        "enum": ["pending", "running", "done", "failed", "skipped"]
      },
      "Tag": {
        "type": "object",
        "required": ["name", "count"],
        "properties": {
          "name": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "TagsResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          }
        }
      },
      "IdeaContext": {
        "type": "object",
        "properties": {
          "target_region": {
            "type": "string"
          },
          "audience_hint": {
            "type": "string"
          },
          "budget_hint": {
            "type": "string"
          }
        }
      },
      "IdeaBrief": {
        "type": "object",
        "required": [
          "title",
          "one_liner",
          "problem",
          "solution",
          "target_users",
          "value_prop",
          "key_assumptions"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "one_liner": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          },
          "target_users": {
            "type": "string"
          },
          "value_prop": {
            "type": "string"
          },
          "key_assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variants": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["title", "description"],
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "IdeaVersionSummary": {
        "type": "object",
        "required": ["id", "idea_id", "number", "raw_input", "created_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "idea_id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer"
          },
          "raw_input": {
            "type": "string"
          },
          "context": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/IdeaContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "brief": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/IdeaBrief"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RunStep": {
        "type": "object",
        "required": ["step", "status", "cost_usd", "attempts"],
        "properties": {
          "step": {
            "$ref": "#/components/schemas/RunStepName"
          },
          "status": {
            "$ref": "#/components/schemas/StepStatus"
          },
          "cost_usd": {
            "type": "number"
          },
          "model": {
            "type": ["string", "null"]
          },
          "attempts": {
            "type": "integer"
          },
          "error": {
            "type": ["string", "null"]
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "finished_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "ClarifyingQuestion": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "help": {
            "type": ["string", "null"]
          }
        }
      },
      "Run": {
        "type": "object",
        "required": [
          "id",
          "idea_id",
          "idea_version_id",
          "status",
          "cost_usd",
          "cost_cap_usd",
          "created_at",
          "steps",
          "questions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "idea_id": {
            "type": "string",
            "format": "uuid"
          },
          "idea_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "step": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunStepName"
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_usd": {
            "type": "number"
          },
          "cost_cap_usd": {
            "type": "number"
          },
          "error": {
            "type": ["string", "null"]
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunStep"
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClarifyingQuestion"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "finished_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "IdeaSummary": {
        "type": "object",
        "required": ["id", "title", "status", "pinned", "created_at", "updated_at", "tags"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/IdeaStatus"
          },
          "verdict": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": ["string", "null"]
          },
          "overall_score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "one_liner": {
            "type": ["string", "null"]
          },
          "pinned": {
            "type": "boolean"
          },
          "archived_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "IdeaDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IdeaSummary"
          },
          {
            "type": "object",
            "required": ["versions"],
            "properties": {
              "versions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IdeaVersionSummary"
                }
              },
              "latest_version": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/IdeaVersionSummary"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latest_run": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Run"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        ]
      },
      "IdeaList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IdeaSummary"
            }
          },
          "next_cursor": {
            "type": ["string", "null"]
          },
          "mode": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SearchMode"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CreateIdeaRequest": {
        "type": "object",
        "required": ["raw_input"],
        "properties": {
          "raw_input": {
