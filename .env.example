# ---------------------------------------------------------------------------
# Idea Forge environment. Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# App
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://idea:idea@localhost:5432/idea_forge

# OpenAI: LLM agents and embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Per-agent models ("provider:model"). Swap provider here without code changes.
REFINER_MODEL=openai:gpt-4o-mini
CLARIFIER_MODEL=openai:gpt-4o-mini
MARKET_MODEL=openai:gpt-4o
COMPETITOR_MODEL=openai:gpt-4o
CUSTOMER_MODEL=openai:gpt-4o
FEASIBILITY_MODEL=openai:gpt-4o
BUSINESS_MODEL=openai:gpt-4o
CRITIC_MODEL=openai:gpt-4o

# TypeSafe AI / Jev
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=60

# Research tools
TAVILY_API_KEY=
TAVILY_COST_PER_SEARCH_USD=0.008
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=idea-forge/0.1 (personal research)
LEADS_ENABLED=false
LEADS_API_KEY=
# Cache TTLs (hours), request behaviour, and per-adapter rate limits (requests/min)
RESEARCH_WEB_TTL_HOURS=168
RESEARCH_COMMUNITY_TTL_HOURS=24
RESEARCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_RETRIES=2
RESEARCH_SNIPPET_MAX_CHARS=1500
WEB_RATE_LIMIT_PER_MINUTE=60
REDDIT_RATE_LIMIT_PER_MINUTE=100
HN_RATE_LIMIT_PER_MINUTE=60
LEADS_RATE_LIMIT_PER_MINUTE=30

# Pipeline
RUN_COST_CAP_USD=0.75
STEP_TIMEOUT_SECONDS=120
MAX_PARALLEL_RESEARCH_AGENTS=3

# Cost accounting (USD per 1M tokens), keys are "provider:model"
# JSON object; falls back to a conservative default for unknown models.
MODEL_PRICING_JSON={"openai:gpt-4o": {"input": 2.5, "output": 10.0}, "openai:gpt-4o-mini": {"input": 0.15, "output": 0.6}}

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
