# ---------------------------------------------------------------------------
# Idea Forge environment. Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# App
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://idea:idea@localhost:5432/idea_forge

# OpenAI: LLM agents and embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Per-agent models ("provider:model"). Swap provider here without code changes.
REFINER_MODEL=openai:gpt-4o-mini
CLARIFIER_MODEL=openai:gpt-4o-mini
MARKET_MODEL=openai:gpt-4o
COMPETITOR_MODEL=openai:gpt-4o
CUSTOMER_MODEL=openai:gpt-4o
FEASIBILITY_MODEL=openai:gpt-4o
BUSINESS_MODEL_MODEL=openai:gpt-4o
CRITIC_MODEL=openai:gpt-4o

# Cost accounting table, USD per 1M tokens, JSON keyed by "provider:model".
# Unknown models fall back to zero cost.
MODEL_PRICING={"openai:gpt-4o": {"input": 2.5, "output": 10.0}, "openai:gpt-4o-mini": {"input": 0.15, "output": 0.6}, "openai:text-embedding-3-small": {"input": 0.02, "output": 0.0}}

# TypeSafe AI / Jev
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=60
JEV_MAX_QUESTIONS_PER_CALL=20
# Ask before changing these (see SPEC.md boundaries)
JEV_CONFIDENCE_FLOOR=0.6
JEV_CLAIM_THRESHOLD=0.7
# Jev pricing is not public; defaults are 0 until the account quota is confirmed.
JEV_INPUT_USD_PER_MILLION=0
JEV_OUTPUT_USD_PER_MILLION=0

# Research tools
TAVILY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=idea-forge/0.1 (personal research)
# Lead DB stays off until the provider question in SPEC.md is answered.
LEADS_ENABLED=false
LEADS_API_KEY=
RESEARCH_WEB_TTL_HOURS=168
RESEARCH_COMMUNITY_TTL_HOURS=24
RESEARCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_RETRIES=2
RESEARCH_SNIPPET_MAX_CHARS=1500
WEB_RATE_LIMIT_PER_MINUTE=60
REDDIT_RATE_LIMIT_PER_MINUTE=100
HN_RATE_LIMIT_PER_MINUTE=60
LEADS_RATE_LIMIT_PER_MINUTE=30
TAVILY_COST_PER_SEARCH_USD=0.008

# Pipeline
RUN_COST_CAP_USD=0.75
STEP_TIMEOUT_SECONDS=120
STEP_MAX_RETRIES=2
MAX_PARALLEL_RESEARCH_AGENTS=3
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_JOB_STALE_SECONDS=900
MAX_CRITIC_RERESEARCH_PASSES=1

# Reports: dimension weights for the 0-100 overall score (competition inverted).
REPORT_SCORE_WEIGHTS={"problem_severity": 0.2, "market_evidence": 0.2, "competition_intensity": 0.15, "customer_reachability": 0.15, "feasibility": 0.15, "monetization_clarity": 0.15}
PDF_RENDER_TIMEOUT_SECONDS=10

# API CORS origins (JSON list)
API_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
